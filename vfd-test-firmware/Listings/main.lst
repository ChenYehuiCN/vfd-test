 126          void timer1_init(void)
 127          {
 128   1        TMOD &= 0x0F;
 129   1        TMOD |= 0x20;
 130   1        TH1 = 0x00;
 131   1        TL1 = 0x00;
 132   1        ET1 = 1;
 133   1        EA  = 1;
 134   1        TR1 = 1;
 135   1      }
 136          
 137          void timer1_isr(void) interrupt 3
 138          {
 139   1        if (VF_OK) {
 140   2          unsigned char ch = display_buffer[gate];
 141   2          unsigned short display;
 142   2          if ((ch < ' ') || (ch > '~'))
 143   2            display = 0x0000;
 144   2          else
 145   2            display = font_table[ch - ' '];
 146   2          VGP_ON = 1;
 147   2          P1 = 0x00;
 148   2          P3 = (P3 & 0x03) | (unsigned char)(display >> 8);
 149   2          P2 = (char)display;
 150   2          P1 = (unsigned char)0x01 << gate;
 151   2          gate = (gate + 1) % DIGIT_COUNT;
 152   2        } else
 153   1          VGP_ON = 0;
 154   1      }
 155          
 156          void main(void)
 157          {
 158   1        P0 = 0x00;
 159   1        P1 = 0x00;
 160   1        P2 = 0x00;
 161   1        P3 = 0x00;
 162   1        VF_OK = 1;
 163   1        timer1_init();
 164   1        VF_ON = 1;
 165   1        while (1);
 166   1      }


